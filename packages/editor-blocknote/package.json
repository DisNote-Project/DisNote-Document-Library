{
  "name": "@disnote/editor-blocknote",
  "version": "0.1.0",
  "description": "BlockNote editor adapter for DisNote Document. Converts between DisNoteDocument and BlockNote, and exposes <DisNoteEditor> without leaking the vendor API.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@disnote/document-core": "0.1.0"
  },
  "peerDependencies": {
    "@blocknote/core": "0.52.1",
    "@blocknote/react": "0.52.1",
    "react": "^18.3.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@blocknote/core": { "optional": true },
    "@blocknote/react": { "optional": true }
  }
}
