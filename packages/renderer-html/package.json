{
  "name": "@disnote/renderer-html",
  "version": "0.2.0",
  "description": "Safe HTML / SSR renderer for DisNote Document. No editor, no React, no DOM.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@disnote/document-core": "0.2.0"
  }
}
