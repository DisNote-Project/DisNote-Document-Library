{
  "name": "@disnote/core",
  "version": "0.6.0",
  "description": "DisNote Document unified core library.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
