{
  "name": "@disnote/react",
  "version": "0.2.0",
  "description": "Ready-to-use DisNote React editor with compatible runtime dependencies and CSS tokens.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/DisNote-Project/DisNote-Document-Library/blob/main/docs/REACT_INTEGRATION_AND_CSS.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DisNote-Project/DisNote-Document-Library.git",
    "directory": "packages/react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view.d.ts",
      "import": "./dist/view.js",
      "default": "./dist/view.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "npm run build"
  },
  "typesVersions": {
    "*": {
      "view": [
        "dist/view.d.ts"
      ]
    }
  },
  "dependencies": {
    "@disnote/core": "^0.8.0",
    "@blocknote/core": "0.52.1",
    "@blocknote/react": "0.52.1",
    "@blocknote/mantine": "0.52.1",
    "@blocknote/xl-multi-column": "0.52.1",
    "yjs": "^13.6.18",
    "y-protocols": "^1.0.6",
    "y-prosemirror": "^1.3.7"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  }
}
