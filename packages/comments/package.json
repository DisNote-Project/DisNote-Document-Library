{
  "name": "@disnote/comments",
  "version": "0.2.0",
  "description": "Comment threads, mention providers and connected-context references for DisNote Document. Comments live outside document content.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
